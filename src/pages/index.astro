---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, about, publications, conferencePhotos } from '../data/portfolio';
import { ArrowUpRight, Download, Mail, Smile } from 'lucide-astro';

const oauthProject = {
  title: 'Rust Google OAuth2',
  description: 'OAuth 2.0 implementation in Rust with PKCE, JWT validation, and Askama templates.',
  techStack: 'Rust · OAuth2 · PKCE · JWT',
  githubUrl: 'https://github.com/mattc-try/rust-google-oauth2',
};
---

<Layout>
  <Header />

  <main class="md:ml-[180px]">
    <section class="mx-auto max-w-[820px] px-5 py-12 sm:px-8 sm:py-16">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-[#8b503d] dark:text-[#d89a82]">Cryptography · Formal verification · Security engineering</p>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-bold tracking-tight text-[#20251e] dark:text-[#f1efe7] sm:text-[38px]">{profile.name}</h1>
        <Smile class="h-5 w-5 -rotate-6 text-[#9b604b] dark:text-[#d89a82]" aria-label="Smiling portrait mark" />
      </div>
      <p class="mt-2 max-w-xl text-sm leading-6 text-[#5f655a] dark:text-[#bbbdb3]">{profile.title}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <a class="inline-flex items-center gap-1.5 font-semibold text-[#20251e] underline decoration-[#9b604b] underline-offset-4 dark:text-[#f1efe7]" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer"><Download class="h-3.5 w-3.5" /> CV</a>
        <a class="inline-flex items-center gap-1 text-[#60665b] hover:text-[#8b503d] dark:text-[#bbbdb3] dark:hover:text-[#d89a82]" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight class="h-3 w-3" /></a>
        <a class="inline-flex items-center gap-1 text-[#60665b] hover:text-[#8b503d] dark:text-[#bbbdb3] dark:hover:text-[#d89a82]" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <ArrowUpRight class="h-3 w-3" /></a>
        <a class="inline-flex items-center gap-1 text-[#60665b] hover:text-[#8b503d] dark:text-[#bbbdb3] dark:hover:text-[#d89a82]" href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID <ArrowUpRight class="h-3 w-3" /></a>
        <a class="inline-flex items-center gap-1.5 text-[#60665b] hover:text-[#8b503d] dark:text-[#bbbdb3] dark:hover:text-[#d89a82]" href={`mailto:${profile.email}`}><Mail class="h-3.5 w-3.5" /> {profile.email}</a>
      </div>
    </section>

    <section id="about">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">About</h2>
        <div class="max-w-[650px]">
          <p class="text-[15px] leading-7 text-[#30352e] dark:text-[#d6d7cf]"><span class="mr-1 text-[#9b604b] dark:text-[#d89a82]">✦</span>{about.summary}</p>
          <p class="mt-3 text-sm leading-6 text-[#666b60] dark:text-[#aeb2a6]">{about.researchInsight}</p>
        </div>
      </div>
    </section>

    <section id="publications">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">Publications</h2>
        <div>
          {publications.map((publication) => (
            <article class="grid gap-1 py-3 sm:grid-cols-[72px_minmax(0,1fr)]">
              <p class="pt-0.5 text-xs text-[#777c70] dark:text-[#9ea39a]">{publication.year}</p>
              <div>
                <h3 class="text-[15px] font-semibold leading-5 text-[#20251e] dark:text-[#f1efe7]">{publication.title}</h3>
                {publication.authors.length > 0 && <p class="mt-1 text-xs leading-5 text-[#686d62] dark:text-[#adb1a6]">{publication.authors.join(', ')}</p>}
                <p class="mt-0.5 text-xs text-[#777c70] dark:text-[#9ea39a]">{publication.venue}</p>
                <div class="mt-1.5 flex flex-wrap gap-3 text-xs">
                  {publication.pdfUrl && <a class="font-medium text-[#8b503d] underline underline-offset-2 dark:text-[#d89a82]" href={publication.pdfUrl} target="_blank" rel="noopener noreferrer">pdf</a>}
                  {publication.codeUrl && <a class="font-medium text-[#8b503d] underline underline-offset-2 dark:text-[#d89a82]" href={publication.codeUrl} target="_blank" rel="noopener noreferrer">code</a>}
                  {publication.artifacts.map((artifact) => <a class="text-[#60665b] underline underline-offset-2 dark:text-[#adb1a6]" href={artifact.url} target="_blank" rel="noopener noreferrer">{artifact.name}</a>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">Experience</h2>
        <div>
          <article class="py-3">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-[15px] font-semibold text-[#20251e] dark:text-[#f1efe7]">⌁ Integrasys · R&D Cryptography Engineer</h3>
              <p class="shrink-0 text-xs text-[#777c70] dark:text-[#9ea39a]">2025–present</p>
            </div>
            <p class="mt-1 max-w-[650px] text-sm leading-6 text-[#666b60] dark:text-[#aeb2a6]">EU Defence Fund cryptography programs, hybrid quantum-safe systems, and lightweight implementations for constrained devices.</p>
          </article>
          <article class="py-3">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-[15px] font-semibold text-[#20251e] dark:text-[#f1efe7]">Australian National University · PhD Candidate</h3>
              <p class="shrink-0 text-xs text-[#777c70] dark:text-[#9ea39a]">present</p>
            </div>
            <p class="mt-1 max-w-[650px] text-sm leading-6 text-[#666b60] dark:text-[#aeb2a6]">Machine-checked security proofs for post-quantum zero-knowledge proofs in EasyCrypt.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="gallery">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">Events</h2>
        <div>
          <div class="flex gap-3 overflow-x-auto pb-2" aria-label="Conference gallery">
            {conferencePhotos.map((photo) => (
              <button
                type="button"
                class="group w-[132px] shrink-0 text-left"
                data-gallery-image={photo.imageUrl}
                data-gallery-title={photo.title}
                data-gallery-detail={`${photo.event} · ${photo.location}`}
                aria-label={`Open preview: ${photo.title}`}
              >
                <img src={photo.imageUrl} alt={photo.description || photo.title} width="132" height="88" class="h-[88px] w-[132px] object-cover ring-1 ring-[#d7d1c2] transition-opacity group-hover:opacity-80 dark:ring-[#41463a]" loading="lazy" />
                <span class="mt-1 block text-xs font-semibold leading-4 text-[#30352e] dark:text-[#d6d7cf]">{photo.event}</span>
                <span class="block text-[11px] text-[#777c70] dark:text-[#9ea39a]">{photo.location} · {photo.date}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <dialog id="gallery-dialog" class="m-auto max-h-[90vh] w-[min(900px,calc(100%-24px))] bg-transparent p-0 backdrop:bg-black/75">
      <div class="relative bg-[#f7f5ef] p-3 dark:bg-[#171916]">
        <button type="button" id="gallery-close" class="absolute right-5 top-5 z-10 flex h-8 w-8 items-center justify-center bg-[#20251e] text-sm text-white dark:bg-[#f1efe7] dark:text-[#20251e]" aria-label="Close preview">×</button>
        <img id="gallery-dialog-image" src="" alt="" class="max-h-[72vh] w-full object-contain" />
        <p id="gallery-dialog-title" class="mt-2 text-sm font-semibold text-[#20251e] dark:text-[#f1efe7]"></p>
        <p id="gallery-dialog-detail" class="text-xs text-[#777c70] dark:text-[#9ea39a]"></p>
      </div>
    </dialog>

    <script is:inline>
      const dialog = document.getElementById('gallery-dialog');
      const dialogImage = document.getElementById('gallery-dialog-image');
      const dialogTitle = document.getElementById('gallery-dialog-title');
      const dialogDetail = document.getElementById('gallery-dialog-detail');
      document.querySelectorAll('[data-gallery-image]').forEach((button) => {
        button.addEventListener('click', () => {
          dialogImage.src = button.dataset.galleryImage;
          dialogImage.alt = button.dataset.galleryTitle;
          dialogTitle.textContent = button.dataset.galleryTitle;
          dialogDetail.textContent = button.dataset.galleryDetail;
          dialog.showModal();
        });
      });
      document.getElementById('gallery-close')?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>

    <section id="projects">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">Project</h2>
        <article class="py-3">
          <h3 class="text-[15px] font-semibold text-[#20251e] dark:text-[#f1efe7]">
            <a class="inline-flex items-center gap-1 hover:text-[#8b503d] dark:hover:text-[#d89a82]" href={oauthProject.githubUrl} target="_blank" rel="noopener noreferrer">{oauthProject.title} <ArrowUpRight class="h-3 w-3" /></a>
          </h3>
          <p class="mt-1 max-w-[650px] text-sm leading-6 text-[#666b60] dark:text-[#aeb2a6]">{oauthProject.description}</p>
          <p class="mt-1 text-xs text-[#777c70] dark:text-[#9ea39a]">{oauthProject.techStack}</p>
        </article>
      </div>
    </section>

    <section id="funding">
      <div class="mx-auto grid max-w-[820px] gap-3 px-5 py-8 sm:px-8 md:grid-cols-[110px_minmax(0,1fr)]">
        <h2 class="text-xs font-bold uppercase tracking-wide text-[#777c70] dark:text-[#9ea39a]">Funding</h2>
        <div class="py-3 text-sm leading-6 text-[#666b60] dark:text-[#aeb2a6]">
          <p><span class="font-semibold text-[#20251e] dark:text-[#f1efe7]">EU Defence Fund · National defence calls</span><br />Co-authored proposals that secured multi-million-euro consortium funding for European cybersecurity and cryptography R&D programmes.</p>
          <p class="mt-3"><a href="https://study.anu.edu.au/scholarships/find-scholarship/anu-university-research-scholarships" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#20251e] underline underline-offset-2 hover:text-[#8b503d] dark:text-[#f1efe7] dark:hover:text-[#d89a82]">ANU University Research Scholarships</a><br />Salary award · Australian National University.</p>
          <p class="mt-3"><a href="https://study.anu.edu.au/scholarships/find-scholarship/hdr-fee-remission-merit-scholarship" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#20251e] underline underline-offset-2 hover:text-[#8b503d] dark:text-[#f1efe7] dark:hover:text-[#d89a82]">HDR Fee Remission Merit Scholarship</a><br />Fee remission award · Australian National University.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="mx-auto flex max-w-[820px] items-center justify-between gap-4 px-5 py-7 sm:px-8">
        <p class="text-sm text-[#666b60] dark:text-[#aeb2a6]">Interested in research or collaboration?</p>
        <a class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#8b503d] underline underline-offset-4 dark:text-[#d89a82]" href={`mailto:${profile.email}?subject=Cryptography%20research%20enquiry`}><Mail class="h-3.5 w-3.5" /> Email</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
